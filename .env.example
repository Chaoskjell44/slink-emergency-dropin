# Copy this file to .env and adjust as needed.
# These settings are used by docker-compose and by the Node server.

# Port the maintenance server listens on inside the container.
PORT=3000

# Where local images are mounted inside the container.
IMAGES_DIR=/app/images

# Storage backend: "local" (default), "smb" or "s3".
STORAGE_PROVIDER=local

# Set to "false" to disable image forwarding entirely and return the maintenance
# page on every route, just like the Shlink drop-in.
SERVE_IMAGES=true

# ---- SMB settings (only used when STORAGE_PROVIDER=smb) ----

# SMB server host and share name.
# SMB_HOST=192.168.1.100
# SMB_SHARE=slink-storage

# SMB authentication.
# SMB_USERNAME=slink-user
# SMB_PASSWORD=your-secure-password

# Optional SMB settings.
# SMB_WORKGROUP=WORKGROUP
# SMB_PORT=445

# Directory inside the share that holds the original images.
# Slink creates "slink/images" on the share by default.
# SMB_IMAGE_PATH=slink/images

# ---- S3 settings (only used when STORAGE_PROVIDER=s3) ----

# Required: bucket name.
AMAZON_S3_BUCKET=

# AWS region, e.g. us-east-1. For custom S3-compatible services this is
# still used for signing and defaults to "auto" if left empty.
AMAZON_S3_REGION=us-east-1

# Static credentials. Leave empty if you use an IAM role (AWS only).
AMAZON_S3_ACCESS_KEY_ID=
AMAZON_S3_SECRET_ACCESS_KEY=

# Use the instance/container IAM role instead of static keys (AWS only).
AMAZON_S3_USE_IAM_ROLE=false

# Optional: custom endpoint for S3-compatible services such as MinIO or Backblaze B2.
# AMAZON_S3_ENDPOINT=https://s3.example.com

# Force path-style bucket URLs. Usually needed for S3-compatible services.
# AMAZON_S3_FORCE_PATH_STYLE=true

# Use a custom S3-compatible provider (auto-enabled when an endpoint is set).
# AMAZON_S3_USE_CUSTOM_PROVIDER=false

# Optional prefix added before the image filename when building S3 keys,
# e.g. "originals/". Slink stores original images in the bucket root by default.
# S3_KEY_PREFIX=

# Optional: path to a custom content.json file (inside the container).
# CONTENT_JSON=./content.json
